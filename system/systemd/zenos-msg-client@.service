[Unit]
Description=ZENOS Messages client (%i)
After=zenos-msg-relay.service
Requires=zenos-msg-relay.service
[Service]
User=zenos
Environment=HOME=/home/zenos
WorkingDirectory=/home/zenos/.local/share/zenos/msg
ExecStart=/bin/bash -c 'exec /usr/bin/node client.js %i $(grep ^%i= ports.env | cut -d= -f2)'
Restart=on-failure
RestartSec=2
[Install]
WantedBy=multi-user.target
