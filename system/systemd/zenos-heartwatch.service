[Unit]
Description=ZENOS sensor dead-man watcher (stand-in for a peer node)
After=zenos-netsentinel.service
[Service]
Environment=PULSE_SERVER=unix:/mnt/wslg/PulseServer
ExecStart=/usr/bin/python3 -I /usr/local/sbin/zheartbeat.py watcher 0
Restart=always
RestartSec=1
[Install]
WantedBy=multi-user.target
