[Unit]
Description=ZENOS audit shipping (ledgers to the audit nodes)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/zenos/audit.json
Wants=zenos-identity.service
After=zenos-identity.service

[Service]
ExecStart=/usr/bin/python3 -I /usr/sbin/zenos_auditship.py
Restart=always
RestartSec=10
# Confined: reads the ledgers (users' too: CAP_DAC_READ_SEARCH only) and sends them; writes only its own state.
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
ReadWritePaths=/var/lib/zenos /var/log/zenos
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
DevicePolicy=closed
DeviceAllow=/dev/tpmrm0 rw

[Install]
WantedBy=multi-user.target
