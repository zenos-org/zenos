[Unit]
Description=ZENOS periodic endpoint audit (Security Note)
After=zenos-netsentinel.service
[Service]
User=zenos
Environment=HOME=/home/zenos
Environment=PULSE_SERVER=unix:/mnt/wslg/PulseServer
ExecStart=/usr/bin/python3 -I /usr/local/sbin/zsecaudit_loop.py
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
