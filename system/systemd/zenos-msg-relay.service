[Unit]
Description=ZENOS Messenger relay (ciphertext-only)
After=network.target
[Service]
User=zenos
Environment=HOME=/home/zenos
WorkingDirectory=/home/zenos/.local/share/zenos/msg
ExecStart=/usr/bin/node /home/zenos/.local/share/zenos/msg/relay.js
Restart=always
RestartSec=2
[Install]
WantedBy=multi-user.target
