# /etc/zenos/keysvc-server.env: the key service (zenos-keysvc.service). The TLS certificate and key go in
# /etc/zenos/keysvc.crt and /etc/zenos/keysvc.key. Administration (enrol PCs, clearances, officers, passkeys):
# stop the service, run as root on its state directory, start it again (systemd gives the files back to the
# service's account when it starts):
#   sudo systemctl stop zenos-keysvc
#   sudo python3 /usr/share/zenos-grid/audit/zenos_keysvc.py --store /var/lib/private/zenos-keys --enroll MACHINE PUBKEY
#   sudo systemctl start zenos-keysvc
AUDIT_URL=https://audit.ministry.example:8443
AUDIT_PUB=<the audit node's key from zenos_auditnode.py --show-key>
PORT=8444
# a confirmation on the user's passkey from this level up; 6 = never (the confirmation page is not built yet)
PRESENCE_FROM=6
RATE_MAX=30
# the address phones reach this service at (its own pages: setting up a phone, confirming a file)
ORIGIN=https://keys.ministry.example:8444
# alerts to officers through ZENOS Messages: a Messages client for this server's own account, on 127.0.0.1
NOTIFY_ARGS=--notify-url http://127.0.0.1:8790/api/send --notify-to sato.01,tanaka.02
