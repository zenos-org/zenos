# ZENOS boot screen (Figma: Boot - disk passphrase)
Window.SetBackgroundTopColor(0.118, 0.290, 0.604);
Window.SetBackgroundBottomColor(0.231, 0.165, 0.478);

W = Window.GetWidth(); H = Window.GetHeight(); X0 = Window.GetX(); Y0 = Window.GetY();
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(X0 + W / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Y0 + H / 2 - 150);

name.image = Image.Text("ZENOS", 1, 1, 1, 1, "Sans Bold 26");
name.sprite = Sprite(name.image);
name.sprite.SetX(X0 + W / 2 - name.image.GetWidth() / 2);
name.sprite.SetY(Y0 + H / 2 - 40);

foot.image = Image.Text("Developer Preview \u00b7 not yet for classified data", 0.55, 0.56, 0.6, 1, "Sans 10");
foot.sprite = Sprite(foot.image);
foot.sprite.SetX(X0 + W / 2 - foot.image.GetWidth() / 2);
foot.sprite.SetY(Y0 + H - 48);

field.image = Image("field.png");

fun show_password(prompt, bullets) {
    ask.image = Image.Text("Enter the disk passphrase to start this PC", 0.79, 0.8, 0.83, 1, "Sans 12");
    ask.sprite = Sprite(ask.image);
    ask.sprite.SetX(X0 + W / 2 - ask.image.GetWidth() / 2);
    ask.sprite.SetY(Y0 + H / 2 + 12);
    box.sprite = Sprite(field.image);
    box.sprite.SetX(X0 + W / 2 - field.image.GetWidth() / 2);
    box.sprite.SetY(Y0 + H / 2 + 40);
    s = "";
    for (i = 0; i < bullets && i < 32; i++) s += "\u25cf";
    dots.image = Image.Text(s, 1, 1, 1, 1, "Sans 11");
    dots.sprite = Sprite(dots.image);
    dots.sprite.SetX(X0 + W / 2 - field.image.GetWidth() / 2 + 14);
    dots.sprite.SetY(Y0 + H / 2 + 40 + field.image.GetHeight() / 2 - dots.image.GetHeight() / 2);
}

fun show_normal() {
    ask.sprite = NULL; box.sprite = NULL; dots.sprite = NULL;
}

fun show_message(text) {
    msg.image = Image.Text(text, 0.79, 0.8, 0.83, 1, "Sans 11");
    msg.sprite = Sprite(msg.image);
    msg.sprite.SetX(X0 + W / 2 - msg.image.GetWidth() / 2);
    msg.sprite.SetY(Y0 + H / 2 + 96);
}

Plymouth.SetDisplayPasswordFunction(show_password);
Plymouth.SetDisplayNormalFunction(show_normal);
Plymouth.SetMessageFunction(show_message);
