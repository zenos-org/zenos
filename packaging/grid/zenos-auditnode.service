[Unit]
Description=ZENOS audit node (keeps every enrolled PC's ledger outside the PC; one member of the consortium)
Documentation=file:///usr/share/doc/zenos-grid/README.md
ConditionPathExists=/etc/zenos/auditnode.json
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=zenos-audit
StateDirectoryMode=0700
# the TLS key stays root-only in /etc/zenos; the service reads a copy systemd hands it
LoadCredential=auditnode.crt:/etc/zenos/auditnode.crt
LoadCredential=auditnode.key:/etc/zenos/auditnode.key
ExecStart=/usr/bin/python3 -I /usr/share/zenos-grid/audit/zenos_auditnode.py --config /etc/zenos/auditnode.json --store /var/lib/zenos-audit
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
