[Unit]
Description=ZENOS storage node (keeps encrypted shards, never keys)
Documentation=file:///usr/share/doc/zenos-grid/README.md
ConditionPathExists=/etc/zenos/storage-node.json
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=zenos-storage
StateDirectoryMode=0700
ExecStart=/usr/bin/node /usr/share/zenos-grid/storage/bin/zenos-store.js node --config /etc/zenos/storage-node.json --dir /var/lib/zenos-storage
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
