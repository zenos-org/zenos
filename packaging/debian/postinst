#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    mkdir -p /var/log/zenos
    chmod 750 /var/log/zenos
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
    fi
    # clearances (which levels each user may open without an approval) are set by the administrator:
    #   sudo zenos_keyd.py --clearance <user> <1-5>      until then every user is cleared for L1 only
    mkdir -p /etc/zenos
    [ -e /etc/zenos/clearance ] || printf '# user = level (1-5). Set with: sudo zenos_keyd.py --clearance USER N\n' > /etc/zenos/clearance
    for u in zenos-keyd zenos-firewall zenos-netsentinel zenos-secstat zenos-heartwatch zenos-guardd zenos-auditship; do
        systemctl enable "$u.service" >/dev/null 2>&1 || true     # one at a time: a masked unit must not stop the rest
    done
    if [ -d /run/systemd/system ]; then
        # never take the inbound lockdown down during an upgrade: start it if needed, otherwise re-apply the
        # rules in place (the script flushes and refills its own chain), so there is no unprotected window
        if systemctl is-active --quiet zenos-firewall.service; then
            /usr/sbin/zenos-firewall >/dev/null || true
        else
            systemctl start zenos-firewall.service || true
        fi
        for u in zenos-keyd zenos-netsentinel zenos-secstat zenos-heartwatch zenos-guardd; do
            systemctl restart "$u.service" 2>/dev/null || true
        done
        systemctl try-restart zenos-auditship.service || true
    fi
    # per-user endpoint audit, for every user session
    systemctl --global enable zenos-secaudit.service zenos-livekit.service >/dev/null 2>&1 || true
    update-desktop-database -q /usr/share/applications 2>/dev/null || true
    # ZENOS runs in the Plasma X11 session (the guard's screen and terminal controls and the apps need X11).
    # SDDM in Debian 13 has no setting for a default session, so the Wayland session is moved out of its list.
    dpkg-divert --package zenos --rename --quiet \
        --divert /usr/share/zenos/plasma-wayland.desktop.disabled --add /usr/share/wayland-sessions/plasma.desktop || true
    rm -f /var/lib/sddm/state.conf 2>/dev/null || true      # forget a Wayland session chosen earlier
    # KRunner's command line: without this, Alt+Space runs any shell command as the user, past the terminal
    # control. KDE's Kiosk "shell_access" restriction turns that runner off; [$i] keeps users from overriding it.
    mkdir -p /etc/xdg
    if ! grep -q '^# zenos: begin' /etc/xdg/kdeglobals 2>/dev/null; then
        printf '\n# zenos: begin (removed when the zenos package is removed)\n[KDE Action Restrictions][$i]\nshell_access=false\n# zenos: end\n' >> /etc/xdg/kdeglobals
    fi
fi
exit 0
