#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    mkdir -p /var/log/zenos
    chmod 750 /var/log/zenos
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
    fi
    # root services: inbound lockdown, network sensor, sensor liveness
    for u in zenos-firewall zenos-netsentinel zenos-heartwatch; do
        systemctl enable "$u.service" >/dev/null 2>&1 || true
        if [ -d /run/systemd/system ]; then systemctl restart "$u.service" || true; fi
    done
    # per-user endpoint audit, for every user session
    systemctl --global enable zenos-secaudit.service >/dev/null 2>&1 || true
    update-desktop-database -q /usr/share/applications 2>/dev/null || true
fi
exit 0
