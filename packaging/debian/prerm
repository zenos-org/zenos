#!/bin/sh
set -e
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    for u in zenos-auditship zenos-guardd zenos-keyd zenos-heartwatch zenos-netsentinel zenos-firewall; do
        if [ -d /run/systemd/system ]; then systemctl stop "$u.service" 2>/dev/null || true; fi
        systemctl disable "$u.service" >/dev/null 2>&1 || true
    done
    systemctl --global disable zenos-secaudit.service zenos-livekit.service >/dev/null 2>&1 || true
    dpkg-divert --package zenos --rename --quiet --remove /usr/share/wayland-sessions/plasma.desktop || true
    if [ -f /etc/xdg/kdeglobals ]; then
        sed -i '/^# zenos: begin/,/^# zenos: end/d' /etc/xdg/kdeglobals || true
    fi
fi
exit 0
